PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=anapath

FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

SESSION_COOKIE_NAME=anapath_session
SESSION_DURATION_HOURS=12
SESSION_COOKIE_SECURE=false

LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MS=900000
SEARCH_RATE_LIMIT_MAX=120
SEARCH_RATE_LIMIT_WINDOW_MS=60000

BOOTSTRAP_ADMIN_LAB_ID=1
BOOTSTRAP_ADMIN_LAB_NAME=Default Laboratory
BOOTSTRAP_ADMIN_FULL_NAME=Default Admin
BOOTSTRAP_ADMIN_EMAIL=admin@anapath.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisAdminPassword123!
